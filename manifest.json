{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "0.8.0",
  "default_locale": "en",
  "minimum_chrome_version": "130",
  "incognito": "not_allowed",
  "permissions": ["storage", "unlimitedStorage", "alarms", "activeTab", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/content/dwell.js", "src/content/extract.js", "src/content/media.js", "src/content/bilibili.js", "src/content/xhs.js", "src/content/content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "src/ui/popup.html", "default_title": "__MSG_extName__" },
  "options_ui": { "page": "src/ui/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
